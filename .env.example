# Supabase (this project's own Supabase project — NOT buildableug's)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# BetPawa — your own account credentials. Never commit, never paste into chat.
BETPAWA_PHONE=
BETPAWA_PASSWORD=
BETPAWA_BASE_URL=https://www.betpawa.ug

# Runner behavior
POLL_INTERVAL_SECONDS=30
HEADLESS=false

# Optional: placement/failure/drawdown notifications (src/notify/telegram.ts).
# Reuse the same bot/chat project-pi's analyze-matches already sends "Daily
# Picks" to, so everything lands in one place. Leave both unset to disable —
# notifications no-op silently rather than failing anything.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
